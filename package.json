{
  "name": "armorcept",
  "version": "0.2.1",
  "description": "Deterministic client-side DLP and prompt injection security mod for Claude Code combining local prompt-armor and Google Cloud Model Armor.",
  "type": "module",
  "main": "./hooks/register.ts",
  "exports": {
    ".": "./hooks/register.ts",
    "./register": "./hooks/register.ts"
  },
  "scripts": {
    "test": "claude plugin test .",
    "validate": "claude plugin validate .",
    "typecheck": "tsc -p .claude-plugin/types/tsconfig.json && tsc --noEmit",
    "daemon:stdio": "python3 python/daemon.py --mode stdio",
    "daemon:http": "python3 python/daemon.py --mode http --port 0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/armorcept/armorcept.git"
  },
  "license": "Apache-2.0"
}

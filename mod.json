{
  "name": "armorcept",
  "version": "0.1.0",
  "description": "Hybrid local (prompt-armor) and enterprise cloud (Google Cloud Model Armor) DLP and prompt injection firewall mod for Claude Code.",
  "main": "./dist/register.js",
  "hooks": [
    "prompt",
    "UserPromptSubmit",
    "tool.call",
    "PreToolUse"
  ],
  "permissions": {
    "hooks": [
      "prompt",
      "UserPromptSubmit",
      "tool.call",
      "PreToolUse"
    ],
    "subprocess": {
      "allow": true,
      "commands": ["python", "python3", "prompt-armor-mcp"]
    },
    "network": {
      "allow": true,
      "domains": [
        "127.0.0.1",
        "localhost",
        "*.googleapis.com",
        "*.rep.googleapis.com"
      ]
    },
    "ui": {
      "allow": true
    }
  }
}
